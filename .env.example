# Canonical application origin used only on the server for future secure links and redirects.
APP_BASE_URL=http://localhost:3000

# Normal application runtime receives only DATABASE_URL. The application role must be a
# non-owner without BYPASSRLS. Use unique local secrets; never commit a populated .env file.
DATABASE_URL=postgresql://rise_pals_app:replace-with-local-password@127.0.0.1:5432/rise_pals?sslmode=disable

# Migration/test tooling only. Never place this table-owner credential in the production
# application environment. Tooling validates that its decoded role differs from DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://rise_pals_owner:replace-with-separate-local-password@127.0.0.1:5432/rise_pals?sslmode=disable

# Clerk Development only. Populate these in an ignored .env.local after Jeff creates and
# configures the synthetic-alpha application. Live keys and real identities are prohibited.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-development-publishable-key
CLERK_SECRET_KEY=sk_test_replace-with-development-secret-key
